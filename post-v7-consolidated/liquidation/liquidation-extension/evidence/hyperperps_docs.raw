{
  "name": "HyperPerps Whale Liquidity API",
  "schema": "hyperperps.whale-heatmap.v4",
  "description": "Market-wide Hyperliquid liquidation, stop-loss, take-profit and positioning map. Rebuilt about every 5 minutes from the full >=$200 leaderboard cohort (~21k wallets; market-makers excluded). Free, no auth, anonymized — clusters only, no per-wallet rows.",
  "symbols": [
    "BTC",
    "ETH",
    "SOL"
  ],
  "endpoints": {
    "discovery": "/api/public/heatmap",
    "per_symbol": "/api/public/heatmap/{symbol}",
    "per_symbol_self_documenting": "/api/public/heatmap/{symbol}?legend=1",
    "example": "/api/public/heatmap/BTC"
  },
  "refresh_seconds": 300,
  "cache_seconds": 60,
  "conventions": {
    "bias_scale": "Directional scalars run -1..+1. Negative = bearish / short lean, positive = bullish / long lean, 0 = balanced.",
    "distance_pct": "Every distance is a signed percent from spot: negative below price, positive above.",
    "nulls": "A null field means no read this cycle (thin data). Check _meta.age_seconds / _meta.stale before trusting any value.",
    "multi_window": "Fields like fresh_money carry per-horizon sub-values (e.g. 1h / 4h / 24h)."
  },
  "cluster_shape": {
    "price": "Price level in USD.",
    "notional_usd": "Total position notional sitting at this level, in USD.",
    "wallet_count": "Distinct accounts at this level.",
    "distance_pct": "Signed percent from spot. Negative = below price, positive = above.",
    "touched_in_last_hour": "True if price wicked through this level in the last hour (the pool has likely already fired — treat as spent)."
  },
  "fields": {
    "updated_at": "Epoch-ms timestamp of the poller's last write for this symbol.",
    "spot_at_compute": "Price the snapshot was computed against — every cluster's distance_pct is relative to this.",
    "spot_fetched_at": "Epoch-ms timestamp when the reference price was fetched after the wallet and order sweeps; use this to judge price freshness.",
    "freshness_seconds": "Age of the snapshot in seconds. Check this before trusting the read.",
    "sample_size": "Open positions analyzed this cycle (market-maker inventory excluded).",
    "longs": "Long-liquidation clusters BELOW price — where longs get force-closed. Downside fuel a sweep runs toward.",
    "shorts": "Short-liquidation clusters ABOVE price — where shorts get force-closed. Upside fuel.",
    "stop_clusters": "Declared stop-loss pools — long_sl_clusters below spot, short_sl_clusters above. Stop-hunt fuel.",
    "explicit_tp": "Resting take-profit walls — sell_side above spot, buy_side below. Where moves stall (supply/demand caps).",
    "mm_walls": "Market-maker resting-order walls — large passive liquidity that absorbs flow.",
    "net_oi_skew": "Net open-interest lean, -1..+1. Positive = crowd net long.",
    "whale_vs_retail": "Directional lean of the biggest accounts (whale_bias) vs the small-wallet tail (retail_bias), each -1..+1, with notional + counts.",
    "whale_entries": "Where big money built: long/short average entry price + the largest entry-price clusters. Reveals whale cost basis vs spot.",
    "trapped_pct": "Fraction of long/short size sitting >=2/5/10% underwater. Forced-sell/-cover pressure building.",
    "scale_out_pressure": "Measured profit-taking / exit pressure on each side, 0..1.",
    "fresh_money": "Net positioning momentum from newly-opened size over the last 1h / 4h / 24h, each -1..+1.",
    "cascade_mass": "Liquidation notional stacked within 1/2/5% of price on each side — how far a cascade could carry.",
    "forced_liq_proximity": "Fraction of size sitting within 2/5% of its own liquidation price — real cascade fuel vs paper losses.",
    "crowd_leverage": "Aggregate leverage profile of the crowd — higher = more fragile to a sweep."
  },
  "support": {
    "message": "This data is free for you. If it helped your trades, you can give a little back: sign up to Hyperliquid with our link. You get a fee discount, and it keeps this feed alive — no pressure.",
    "referral": "https://app.hyperliquid.xyz/join/HYPERPERPSBOT"
  }
}
