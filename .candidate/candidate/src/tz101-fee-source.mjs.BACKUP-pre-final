  if(src.source_kind!=='ACCOUNT_EFFECTIVE_RATE'||src.venue!=='HTX'||src.market_type!=='USDT_PERP'||src.contract_code!==contract||src.fee_role!=='TAKER')
    return out('NOT_CLOSED','ACCOUNT_EFFECTIVE_FEE_SOURCE_NOT_PROVEN');
  if(!text(src.source_receipt_id)||!text(src.account_scope_fingerprint)||src.account_scope_fingerprint.length<8||!stamp(src.source_ts)||!stamp(src.valid_until_ts)||!stamp(now)||src.source_ts>now||src.valid_until_ts<now)
    return out('NOT_CLOSED','ACCOUNT_EFFECTIVE_FEE_PROVENANCE_OR_FRESHNESS_INVALID');
  if(!finite(src.entry_rate)||!finite(src.exit_rate)||src.entry_rate<0||src.exit_rate<0||src.entry_rate>0.05||src.exit_rate>0.05)
    return out('NOT_CLOSED','ACCOUNT_EFFECTIVE_FEE_RATE_INVALID');
  // Secrets/tokens/private API signatures are forbidden in the factual record.
  const forbidden=['api_key','secret','token','signature','password','cookie','authorization'];
  const keys=Object.keys(src).map(k=>k.toLowerCase());
  if(forbidden.some(k=>keys.some(x=>x.includes(k)))) return out('NOT_CLOSED','SECRET_BEARING_FEE_RECORD_FORBIDDEN');
  const material={schema_version:'tz101-htx-fee-schedule-v1',status:'CLOSED',venue:'HTX',market_type:'USDT_PERP',contract_code:contract,fee_role:'TAKER',entry_rate:src.entry_rate,exit_rate:src.exit_rate,
    source_kind:'ACCOUNT_EFFECTIVE_RATE',source_receipt_id:src.source_receipt_id,account_scope_fingerprint:src.account_scope_fingerprint,source_ts:src.source_ts,valid_until_ts:src.valid_until_ts};
