import {assertInstrument, createFact, factUsable, CANDLE_NATIVE_RELATIVE_UNIT,
  CANDLE_CCXT_TIME_BASIS} from '../contracts/index.mjs';
import {RELATIVE_CONTEXT_SCHEMA, RELATIVE_CONTEXT_UNIT, RELATIVE_PRICE_BASIS,
  qualifyRelativeContext} from '../contracts/relative-context.mjs';
import {object, text, positive, timestamp, assertEnvelope, requestUrl, fail} from './bingx.mjs';
import {nativeRelativeCandleQualified} from './native-relative-qualification.mjs';

const STEP = 60000, WINDOW = 300000, ROWS = 6;
const VERSION = 'pump-report-relative-context-v1';
const BUDGET = /BUDGET|QUOTA|ADMISSION|RESERVE|EXHAUSTED|BACKOFF|RATE_LIMIT|NOT_ADMITTED|NOT_MEASURED/;
const safeCode = e => ['AbortError', 'TimeoutError'].includes(e?.name) ? 'RELATIVE_CONTEXT_TIMEOUT'
  : /^[A-Z0-9_:.-]{1,160}$/.test(e?.code ?? '') ? e.code : 'RELATIVE_CONTEXT_REQUEST_FAILED';

function exactCloses(rows, {start, end, received, native}) {
  if (!Array.isArray(rows) || rows.length > (native ? ROWS : 1440)) fail('RELATIVE_CONTEXT_BOUNDED_CANDLES_REQUIRED');
  const closes = new Map();
  for (const row of rows) {
    if (!object(row)) fail('RELATIVE_CONTEXT_OBJECT_CANDLE_REQUIRED');
    const open = timestamp(native ? row.time : row.open_ts);
    const close = native ? (open === null ? null : open + STEP) : timestamp(row.close_ts);
    if (open === null || close === null || open % STEP || close !== open + STEP
      || close > received || !native && row.closed !== true) fail('RELATIVE_CONTEXT_CANDLE_CLOCK_UNQUALIFIED');
    if (close < start || close > end) {
      if (native) fail('RELATIVE_CONTEXT_RESPONSE_OUTSIDE_EXACT_WINDOW');
      continue;
    }
    if (closes.has(close)) fail('RELATIVE_CONTEXT_DUPLICATE_CLOSE');
    const price = positive(row.close);
    if (price === null) fail('RELATIVE_CONTEXT_CLOSE_PRICE_INVALID');
    closes.set(close, price);
  }
  for (let at = start; at <= end; at += STEP) {
    if (!closes.has(at)) fail('RELATIVE_CONTEXT_CLOSED_WINDOW_GAP');
  }
  if (closes.size !== ROWS) fail('RELATIVE_CONTEXT_EXACT_SIX_CLOSES_REQUIRED');
  return {start_price: closes.get(start), end_price: closes.get(end)};
}

// A separate price-only parser: volume/quantity/turnover are never read.
export function parseRelativeBenchmarkCandles(body, {start_ts, end_ts, received_ts}) {
  assertEnvelope(body);
  if (timestamp(start_ts) === null || timestamp(end_ts) === null || start_ts % STEP || end_ts % STEP
    || end_ts - start_ts !== WINDOW || timestamp(received_ts) === null) fail('RELATIVE_CONTEXT_EXACT_WINDOW_REQUIRED');
  return exactCloses(body.data, {start: start_ts, end: end_ts, received: received_ts, native: true});
}

export function createRelativeContextLoader({broker, resolveBenchmark, clock, profile}) {
  if (typeof broker?.request !== 'function' || typeof resolveBenchmark !== 'function' || typeof clock !== 'function'
    || profile?.candle_interval_ms !== STEP || profile?.freshness_ms?.market_context !== 90000) {
    fail('RELATIVE_CONTEXT_DEPENDENCIES_REQUIRED');
  }
  const now = () => {const t = timestamp(clock()); if (t === null) fail('RELATIVE_CONTEXT_CLOCK_INVALID'); return t;};
  const ttl = profile.freshness_ms.market_context;
  async function getRelativeContext({entry, candidate_facts = {}, max_requests = 2}) {
    const instrument = entry.instrument;
    assertInstrument(instrument);
    const at = now(), observations = [], sourceFact = candidate_facts?.candles;
    let scheduled = 0;
    const absent = (reason, status = 'NOT_CHECKED') => ({
      fact: createFact({fact_id: VERSION + ':' + instrument.instrument_id + ':' + reason,
        instrument_id: instrument.instrument_id, asset_id: instrument.asset_id, kind: 'market_context',
        value: null, unit: RELATIVE_CONTEXT_UNIT, event_ts: null, received_ts: now(), expires_ts: null,
        source: 'BINGX_OFFICIAL_PUBLIC_API', primary_provider: 'BINGX', venue: 'BINGX',
        market_type: 'PERPETUAL', quote: 'USDT', settle: 'USDT', origin: 'OBSERVED', status, reason,
        identity_evidence_ref: instrument.identity_evidence_ref,
        coverage: {checked: scheduled > 0, benchmark_observations: observations,
          optional_broker_calls_scheduled: scheduled, independent_venue_count: 1,
          candidate_redownloaded: false, quantity_used: false}}),
      requests_reserved: scheduled
    });
    if (!Number.isSafeInteger(max_requests) || max_requests < 0 || max_requests > 2) fail('RELATIVE_CONTEXT_MAX_TWO_REQUESTS');
    if (['BTC', 'ETH'].includes(instrument.base)) return absent('OWNER_EXCLUDED_CANDIDATE_BENCHMARK_ONLY');
    if (!nativeRelativeCandleQualified(entry.qualifications?.candles, instrument, STEP)) {
      return absent('RELATIVE_CONTEXT_CANDIDATE_TIME_BASIS_UNQUALIFIED');
    }
    if (!sourceFact) return absent('RELATIVE_CONTEXT_CANDIDATE_CANDLES_REQUIRED');
    if (!factUsable(sourceFact, at) || sourceFact.kind !== 'candles'
      || sourceFact.instrument_id !== instrument.instrument_id || sourceFact.asset_id !== instrument.asset_id
      || sourceFact.venue !== 'BINGX' || sourceFact.primary_provider !== 'BINGX'
      || sourceFact.source !== 'BINGX_OFFICIAL_PUBLIC_API' || sourceFact.origin !== 'OBSERVED'
      || sourceFact.quote !== 'USDT' || sourceFact.settle !== 'USDT'
      || sourceFact.identity_evidence_ref !== instrument.identity_evidence_ref
      || sourceFact.unit !== CANDLE_NATIVE_RELATIVE_UNIT || !text(sourceFact.fact_id) || !text(sourceFact.evidence_ref)
      || sourceFact.event_ts > sourceFact.received_ts || sourceFact.event_ts % STEP
      || sourceFact.expires_ts > sourceFact.event_ts + profile.freshness_ms.candles
      || sourceFact.coverage?.time_qualified !== true
      || sourceFact.coverage?.time_basis !== CANDLE_CCXT_TIME_BASIS
      || sourceFact.coverage?.interval_ms !== STEP
      || sourceFact.coverage?.time_evidence_ref !== entry.qualifications.candles.time.evidence_ref) {
      return absent('RELATIVE_CONTEXT_CANDIDATE_FACT_UNQUALIFIED');
    }
    const end = sourceFact.event_ts, start = end - WINDOW;
    let prices;
    try {prices = exactCloses(sourceFact.value, {start, end, received: sourceFact.received_ts, native: false});}
    catch (error) {return absent(safeCode(error), 'INCOMPLETE');}
    const makeLeg = (role, legInstrument, prices, original) => ({
      role, instrument: structuredClone(legInstrument), start_ts: start, end_ts: end,
      ...prices, return_pct: 100 * (prices.end_price / prices.start_price - 1),
      fact_id: original.fact_id, price_basis: RELATIVE_PRICE_BASIS, interval_ms: STEP,
      time_basis: CANDLE_CCXT_TIME_BASIS, complete_closed_window: true,
      source: 'BINGX_OFFICIAL_PUBLIC_API', primary_provider: 'BINGX', venue: 'BINGX',
      origin: 'OBSERVED', event_ts: end, received_ts: original.received_ts,
      expires_ts: original.expires_ts, evidence_ref: original.evidence_ref,
      identity_evidence_ref: legInstrument.identity_evidence_ref,
      coverage: {complete_closed_window: true, closed_rows: ROWS,
        source_window_start: start - STEP, source_window_end: end,
        quantity_used: false, same_venue_comparison: true}
    });
    const candidate = makeLeg('CANDIDATE', instrument, prices, sourceFact);
    const planned = [];
    for (const role of ['BTC', 'ETH']) {
      let benchmark;
      try {benchmark = resolveBenchmark(role);} catch {}
      const i = benchmark?.instrument;
      let valid = false;
      try {
        assertInstrument(i);
        valid = i.base === role && i.native_symbol === role + '-USDT'
          && text(i.identity_evidence_ref) && text(benchmark.native_contract_id ?? i.native_contract_id)
          && nativeRelativeCandleQualified(benchmark.qualifications?.candles, i, STEP);
      } catch {}
      if (!valid) {observations.push({role, status: 'NOT_CHECKED', reason: 'RELATIVE_CONTEXT_BENCHMARK_IDENTITY_OR_TIME_BASIS_UNQUALIFIED'}); continue;}
      if (scheduled >= max_requests) {observations.push({role, status: 'NOT_CHECKED', reason: 'NOT_CHECKED_BUDGET'}); continue;}
      scheduled++;
      planned.push((async () => {
        const url = requestUrl('candles', {symbol: i.native_symbol, interval: '1m',
          startTime: start - STEP, endTime: end - 1, limit: ROWS});
        let response;
        try {
          response = await broker.request({provider: 'BINGX', family: 'USDT_M', purpose: 'CORE',
            candidate_id: instrument.instrument_id, method: 'GET', url,
            cache_key: VERSION + ':BINGX:USDT_M:' + url, timeout_ms: 10000,
            ttl_ms: ttl, estimated_cost: {http: 1}});
          if (!object(response) || response.ok !== true || response.status !== 200) {
            fail(response?.status === 429 ? 'RELATIVE_CONTEXT_RATE_LIMITED' : 'RELATIVE_CONTEXT_HTTP_ERROR');
          }
          if (timestamp(response.received_ts) === null || response.received_ts > now()
            || response.received_ts < end || !text(response.receipt_id)) fail('RELATIVE_CONTEXT_ORIGINAL_RECEIPT_CLOCK_INVALID');
          const p = parseRelativeBenchmarkCandles(response.data, {start_ts: start, end_ts: end, received_ts: response.received_ts});
          if (end + ttl < now()) fail('RELATIVE_CONTEXT_BENCHMARK_STALE');
          const leg = makeLeg(role, i, p, {fact_id: VERSION + ':' + i.instrument_id + ':' + response.receipt_id,
            received_ts: response.received_ts, expires_ts: end + ttl, evidence_ref: response.receipt_id});
          observations.push({role, status: 'USABLE', reason: null, evidence_ref: response.receipt_id,
            event_ts: end, received_ts: response.received_ts, expires_ts: end + ttl,
            cache_hit: response.cache_hit === true});
          return leg;
        } catch (error) {
          const reason = safeCode(error);
          observations.push({role, status: BUDGET.test(reason) ? 'NOT_CHECKED' : /STALE/.test(reason) ? 'STALE' : 'ERROR',
            reason, evidence_ref: response?.receipt_id ?? null,
            original_received_ts: response?.received_ts ?? null, spent_or_unknown_not_refunded: true});
          return null;
        }
      })());
    }
    const benchmarks = (await Promise.all(planned)).filter(Boolean);
    if (!benchmarks.length) return absent(scheduled ? 'RELATIVE_CONTEXT_NO_USABLE_BENCHMARK'
      : max_requests === 0 ? 'NOT_CHECKED_BUDGET' : 'RELATIVE_CONTEXT_NO_QUALIFIED_BENCHMARK', scheduled ? 'INCOMPLETE' : 'NOT_CHECKED');
    const legs = [candidate, ...benchmarks], expires = Math.min(end + ttl, ...legs.map(x => x.expires_ts));
    const received = Math.max(...legs.map(x => x.received_ts)), stale = expires < now();
    const fact = createFact({fact_id: VERSION + ':' + instrument.instrument_id + ':' + end + ':' + benchmarks.map(x => x.evidence_ref).join(':'),
      instrument_id: instrument.instrument_id, asset_id: instrument.asset_id, kind: 'market_context',
      value: {schema_version: RELATIVE_CONTEXT_SCHEMA, returns: legs},
      unit: RELATIVE_CONTEXT_UNIT, event_ts: end, received_ts: received, expires_ts: expires,
      source: 'BINGX_OFFICIAL_PUBLIC_API', primary_provider: 'BINGX', venue: 'BINGX',
      market_type: 'PERPETUAL', quote: 'USDT', settle: 'USDT', origin: 'OBSERVED',
      identity_evidence_ref: instrument.identity_evidence_ref, status: stale ? 'STALE' : 'USABLE',
      reason: stale ? 'RELATIVE_CONTEXT_EXPIRED_DURING_LOAD' : null,
      evidence_ref: sourceFact.evidence_ref,
      coverage: {comparison: benchmarks.length === 2 ? 'BTC_AND_ETH' : 'ONE_BENCHMARK',
        complete_closed_window: true, start_ts: start, end_ts: end, closed_rows_each: ROWS,
        benchmark_observations: observations, candidate_redownloaded: false, quantity_used: false,
        independent_venue_count: 1, optional_broker_calls_scheduled: scheduled},
      derived_from: {kind: 'OBSERVED_SAME_WINDOW_CLOSE_RETURNS', fact_ids: legs.map(x => x.fact_id),
        receipt_ids: legs.map(x => x.evidence_ref), original_received_ts: legs.map(x => x.received_ts),
        time_basis: CANDLE_CCXT_TIME_BASIS, quantity_used: false}});
    if (!stale) {
      const qualified = qualifyRelativeContext(fact, {instrument, as_of_ts: now(), freshness_ms: ttl});
      if (!qualified.valid) return absent(qualified.reason, 'INCOMPLETE');
    }
    return {fact, requests_reserved: scheduled};
  }
  return {getRelativeContext};
}

