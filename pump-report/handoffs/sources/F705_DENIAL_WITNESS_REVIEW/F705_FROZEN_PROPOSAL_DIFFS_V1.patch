+// A bounded copy of scalars from the exact admission assessment; never IO.
+const nat=n=>Number.isSafeInteger(n)&&n>=0;
+const details=new Set(['WHOLE_CANDIDATE_DAY_CAPACITY','WHOLE_CANDIDATE_PLANNED_ALLOCATION','WHOLE_CANDIDATE_PROVIDER_DAY','WHOLE_CANDIDATE_PROVIDER_MONTH','EVEN_DAY_CANDIDATE_ALLOCATION']);
+const equations=new Set(['GLOBAL_DAY','PLANNED_ALLOCATION','PROVIDER_DAY','PROVIDER_MONTH','PACING']);
+const termKeys=['global_spent','auto_charged','held_http','base_extra_http','fixed_http','future_discovery_http','future_candidate_http','operation_http_upper_bound','provider_spent','provider_held','provider_fixed','provider_future_discovery','provider_future_candidate','provider_base_extra','provider_operation'];
+export function candidateBudgetDiagnostic({evaluated_ts,detail,stage,equation,lhs,cap,terms,provider=null,pacing=null}={}){
+  if(!nat(evaluated_ts)||!details.has(detail)||!['READ_ONLY_ASSESSMENT','ATOMIC_ASSESSMENT'].includes(stage)||!equations.has(equation)||!nat(lhs)||!nat(cap)||!terms||typeof terms!=='object'||Array.isArray(terms)||provider!==null&&!['BINGX','TELEGRAM'].includes(provider))return null;
+  const copied={};for(const key of termKeys){const n=terms[key]??null;if(n!==null&&!nat(n))return null;copied[key]=n;}
+  let quota=null;if(pacing!==null){quota={};for(const key of ['maximum','issued_current','issued_before','base_per_period']){if(!nat(pacing[key]))return null;quota[key]=pacing[key];}}
+  return {schema:'PUMP_CANDIDATE_BUDGET_DIAGNOSTIC_V1',evaluated_ts,detail,stage,equation,operator:equation==='PACING'?'GTE':'GT',lhs,cap,terms:copied,provider,pacing:quota};
+}
