+// PREPARED ONLY. Opaque tokens belong to one source instance; no IO or market claim.
+const digest=x=>typeof x==='string'&&/^[a-f0-9]{64}$/.test(x);
+const freeze=x=>{if(x&&typeof x==='object'){for(const v of Object.values(x))freeze(v);Object.freeze(x);}return x;};
+const id=i=>JSON.stringify([i.instrument_id,i.asset_id,i.native_symbol,i.venue,i.market_type,i.quote,i.settle,i.classification_status,i.identity_evidence_ref]);
+const empty=e=>e&&e.instrument?.classification_status==='VERIFIED_CRYPTO'&&e.instrument.venue==='BINGX'&&e.instrument.market_type==='PERPETUAL'&&e.instrument.quote==='USDT'&&e.instrument.settle==='USDT'&&typeof e.instrument.identity_evidence_ref==='string'&&e.instrument.identity_evidence_ref.length>0&&!['BTC','ETH'].includes(e.instrument.base)&&e.liquidations&&Object.hasOwn(e.liquidations,'routes')&&Array.isArray(e.liquidations.routes)&&e.liquidations.routes.length===0;
+export function createCandidateRouteCostQuotes({resolve_entry,binding}){
+ const owned=new WeakMap();
+ const enabled=typeof resolve_entry==='function'&&binding&&digest(binding.implementation_sha256)&&digest(binding.registry_sha256);
+ const root=enabled?freeze(structuredClone(binding)):null;
+ function issue({instrument,run_id}={}){
+  if(!root||typeof run_id!=='string'||!run_id||run_id.length>128)return null;
+  let e;try{e=resolve_entry(instrument);}catch{return null;}
+  if(!empty(e)||id(e.instrument)!==id(instrument))return null;
+  // This is the private source entry, never the caller's registry object.
+  Object.freeze(e.liquidations.routes);Object.freeze(e.liquidations);
+  const target=freeze(structuredClone(e.instrument)),entry_binding=id(target);
+  const proof=freeze({schema:'SOURCE_EMPTY_ROUTE_COST_QUOTE_V1',run_id,instrument_id:target.instrument_id,
+   asset_id:target.asset_id,identity_evidence_ref:target.identity_evidence_ref,
+   implementation_sha256:root.implementation_sha256,registry_sha256:root.registry_sha256,entry_binding,
+   allocation_http_upper_bound:12,operation_http_upper_bound:11,
+   http_by_provider:{BINGX:10,TELEGRAM:1},unassigned_map_http_upper_bound:0,
+   basis:'EXPLICIT_FROZEN_EMPTY_ROUTE_ARRAY',coverage_status:'NOT_CHECKED',unsupported_claimed:false});
+  const token=Object.freeze({});owned.set(token,{target,proof});return token;
+ }
+ function read(token,{run_id,candidate_id,implementation_sha256,registry_sha256}={}){
+  const r=token&&owned.get(token);if(!r||run_id!==r.proof.run_id||candidate_id!==r.target.instrument_id||
+   implementation_sha256!==root.implementation_sha256||registry_sha256!==root.registry_sha256)return null;
+  let e;try{e=resolve_entry(r.target);}catch{return null;}
+  return empty(e)&&id(e.instrument)===r.proof.entry_binding?r.proof:null;
+ }
+ return Object.freeze({issue,read});
+}
