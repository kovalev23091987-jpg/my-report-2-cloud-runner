                "1m",
                "5m",
                "15m",
                "1h",
                "4h",
                "1d"
              ]
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_CONTENT"
          },
          "200": {
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Long and short liquidation notional per time bucket.",
        "description": "Every bucket in [start, end) is returned, empty ones as zeros, so the series\ncharts directly. Defaults to the last 24h. At most 2,000 buckets per call.\n`gaps` lists windows the node missed \u2014 a zero there means unknown, not calm.",
        "tags": [
          "liquidations"
        ]
      }
    },
    "/api/liquidations/coins": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "description": "Default 24h ago. Epoch ms, epoch seconds, `YYYY-MM-DD`, or ISO-8601 (UTC if no offset).",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "end",
            "description": "Default now. Epoch ms, epoch seconds, `YYYY-MM-DD`, or ISO-8601 (UTC if no offset).",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 500
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_CONTENT"
          },
          "200": {
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Liquidation totals per market over a window (default last 24h), largest first.",
        "tags": [
          "liquidations"
        ]
      }
    },
    "/api/liquidations/status": {
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Feed health and coverage, plus how to connect to the live websocket.",
        "description": "`data_through` is the chain time of the newest fill read (epoch ms);\n`lag_seconds` is how far that trails now. `gaps` are windows the node\nmissed \u2014 the most recent 200.\n\n**Websocket:** `wss://node.liqflow.app/ws/liquidations`, optional query\nparams `coin` (comma-separated), `side`, `min_usd`, `user`, `since_id`\n(replay everything after that id first, so a reconnect loses nothing) and\n`api_key`. Messages are JSON: one `hello`, then `liquidations` batches\n(`data` is a list of the same rows `/liquidations` returns) and a `gap`\nmessage whenever the node is found to have skipped blocks. The server\npings every 20s.",
        "tags": [
          "liquidations"
        ]
      }
    }
