    "/api/coin/{coin}/stop-levels": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "order_type",
            "description": "Comma-separated list of order types to include. Values: `stopMarket`, `stopLimit`, `takeProfitMarket`, `takeProfitLimit`. Omit to return all four (default).",
            "schema": {
              "type": "string",
              "example": "stopMarket,stopLimit,takeProfitMarket,takeProfitLimit"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "side",
            "description": "Filter by side. `BUY` matches buy-stops (trigger above mark); `SELL` matches sell-stops (trigger below mark).",
            "schema": {
              "type": "string",
              "enum": [
                "BUY",
                "SELL"
              ]
            },
            "required": false
          },
          {
            "in": "query",
            "name": "min_size",
            "description": "Minimum effective order size (in base-asset units). Orders with `size == 0` (full-position TP/SL) use the absolute position size for comparison.",
            "schema": {
              "type": "number"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "description": "Max rows to return. `0` returns all matching rows (no pagination).",
            "schema": {
              "type": "integer",
              "default": 500
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "description": "Pagination offset. Ignored when `limit=0`.",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_CONTENT"
          },
          "200": {
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Stop order levels for a coin.",
        "description": "Returns untriggered stop-market and stop-limit orders whose trigger price\nsits on the correct side of the current mark (sell-stops below, buy-stops\nabove). Rows with unknown mark are included.",
        "tags": [
          "levels"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "coin",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
