            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "end",
            "description": "Exclusive upper bound on fill time. Epoch ms, epoch seconds, `YYYY-MM-DD`, or ISO-8601 (UTC if no offset).",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "interval",
