    "/api/liquidations": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "coin",
            "description": "Comma-separated markets, case-insensitive (`BTC,ETH`, `kPEPE`, `xyz:KIOXIA`). Omit for all.",
            "schema": {
              "type": "string",
              "example": "BTC,ETH"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "start",
            "description": "Inclusive lower bound on fill time. Epoch ms, epoch seconds, `YYYY-MM-DD`, or ISO-8601 (UTC if no offset).",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "end",
            "description": "Exclusive upper bound on fill time. Epoch ms, epoch seconds, `YYYY-MM-DD`, or ISO-8601 (UTC if no offset).",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "user",
            "description": "Only this liquidated wallet (0x\u2026).",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "side",
            "description": "Side of the position that was liquidated.",
            "schema": {
              "type": "string",
              "enum": [
                "long",
                "short"
              ]
            },
            "required": false
          },
          {
            "in": "query",
            "name": "min_usd",
            "description": "Minimum fill notional in USD.",
            "schema": {
              "type": "number"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "since_id",
            "description": "Polling mode: rows with `id` greater than this, OLDEST first. Pass back the `last_id` from the previous response to never miss or repeat a row.",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "before_id",
            "description": "History paging: rows with `id` less than this, newest first. Pass back `next_before_id`.",
            "schema": {
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "description": "Rows per response, 1-1000.",
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "$ref": "#/components/responses/UNPROCESSABLE_CONTENT"
          },
          "200": {
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/DEFAULT_ERROR"
          }
        },
        "summary": "Liquidation fills \u2014 newest first, or oldest first after `since_id`.",
        "description": "To follow the feed by polling, start with no `since_id`, then send each\nresponse's `last_id` back as `since_id`. To walk back through history, send\n`next_before_id` back as `before_id`.",
        "tags": [
          "liquidations"
        ]
      }
    },
    "/api/liquidations/summary": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "coin",
            "description": "Comma-separated markets, case-insensitive (`BTC,ETH`, `kPEPE`, `xyz:KIOXIA`). Omit for all.",
            "schema": {
