red: false\n        type: boolean\n        default: false\n      trigger_task_id:\n        description: "exact original trigger task; required for trigger-only run"\n        required: false\n        default: ""\n      scheduled_recovery_run:\n        description: "internal full-cycle recovery after missing scheduled events"\n        required: false\n        type: boolean\n        default: false\n      public_collector_release:\n        description: "deploy the bounded five-minute HTX public collector"\n        required: false\n        type: boolean\n        default: false\n      manual_run_authorized:\n        description: "explicitly authorize this manual analytics run"\n        required: true\n        type: boolean\n        default: true\n\npermissions:\n  contents: read\n\njobs:\n  execution-gate:\n    runs-on: ubuntu-24.04-arm\n    outputs:\n      admitted: ${{ steps.gate.outputs.admitted }}\n    env:\n      LEGACY_RUNNER_ENABLED: ${{ secrets.REPORT2_RUNNER_ENABLED }}\n      EVENT_NAME: ${{ github.event_name }}\n      TRIGGER_ONLY_RUN: ${{ inputs.trigger_only_run || \'false\' }}\n      TRIGGER_TASK_ID: ${{ inputs.trigger_task_id || \'\' }}\n      SCHEDULED_RECOVERY_RUN: ${{ inputs.scheduled_recovery_run || \'false\' }}\n      RECOVERY_REASON: ${{ inputs.reason || \'\' }}\n      MANUAL_AUTHORIZED: ${{ inputs.manual_run_authorized || \'false\' }}\n    steps:\n      - name: Gate the entire working job\n        id: gate\n        shell: bash\n        run: |\n          set -Eeuo pipefail\n          normalize_true() {\n            case "$(printf \'%s\' "$1" | tr \'[:upper:]\' \'[:lower:]\')" in 1|true|yes|on) return 0 ;; *) return 1 ;; esac\n          }\n          admitted=false\n          if [ "$EVENT_NAME" = "schedule" ]; then\n            if normalize_true "$LEGACY_RUNNER_ENABLED"; then admitted=true; fi\n          elif [ "$EVENT_NAME" = "push" ]; then\n            admitted=true\n          elif [ "$EVENT_NAME" = "workflow_dispatch" ]; then\n            if normalize_true "$SCHEDULED_RECOVERY_RUN"; then\n              if normalize_true "$LEGACY_RUNNER_ENABLED" && ! normalize_true "$MANUAL_AUTHORIZED" && ! normalize_true "$TRIGGER_ONLY_RUN" && [ "$RECOVERY_REASON" = "SCHEDULED_CADENCE_RECOVERY" ]; then admitted=true; fi\n            elif normalize_true "$TRIGGER_ONLY_RUN"; then\n              if normalize_true "$LEGACY_RUNNER_ENABLED" && [ -n "$TRIGGER_TASK_ID" ]; then admitted=true; fi\n            elif normalize_true "$MANUAL_AUTHORIZED"; then admitted=true; fi\n          fi\n          echo "admitted=$admitted" >> "$GITHUB_OUTPUT"\n          echo "REPORT2_EXECUTION_GATE admitted=$admitted event=$EVENT_NAME"\n\n  enqueue-manual-command:\n    if: ${{ inputs.trigger_only_run != true && ((github.event_name == \'push\' && (contains(toJSON(github.event.commits), \'manual-requests/run.json\') || startsWith(github.event.head_commit.message, \'[manual-request]\')) && !contains(github.event.head_commit.message, \'[public-collector-release]\')) || (github.event_name == \'workflow_dispatch\' && inputs.manual_run_authorized == true && inputs.public_collector_release != true && inputs.reason != \'T00_RUNTIME_EXPORT\' && inputs.reason != \'T00_D1_INVENTORY\' && inputs.reason != \'T00_CLOUDFLARE_HUB_AUDIT\' && inputs.reason != \'V13_P0_READ_ONLY_DIAG\' && inputs.reason != \'V13_P0_DRY_RUN\' && inputs.reason != \'V13_SHADOW_MARKET_SMOKE\' && inputs.reason != \'V13_FINAL_37\' && inputs.reason != \'T16_DERIBIT_ALT_OPTIONS_SMOKE\' && inputs.reason != \'T16_CHAIN_SUPPLY_SMOKE\' && inputs.reason != \'T16_SOURCIFY_ABI_SMOKE\' && inputs.reason != \'T16_METADATA_SOURCES_SMOKE\' && inputs.reason != \'T16_OFFICIAL_FEED_SMOKE\' && inputs.reason != \'T16_LIDO_SNAPSHOT_SMOKE\' && inputs.reason != \'T16_LIGHTER_NATIVE_SMOKE\' && inputs.reason != \'T16_GMX_NATIVE_SMOKE\' && inputs.reason != \'T16_GTRADE_NATIVE_SMOKE\' && inputs.reason != \'T16_BLOCKSCOUT_INDEX_SMOKE\') ) }}\n    runs-on: ubuntu-latest\n    outputs:\n      command_id: ${{ steps.enqueue.outputs.command_id }}\n      command: ${{ steps.enqueue.outputs.command }}\n      coin_contract: ${{ steps.enqueue.outputs.coin_contract }}\n    env:\n      REPORT2_D1_BRIDGE_URL: ${{ secrets.REPORT2_D1_BRIDGE_URL }}\n      REPORT2_D1_BRIDGE_TOKEN: ${{ secrets.REPORT2_D1_BRIDGE_TOKEN }}\n      REPORT2_MANUAL_COMMAND: ${{ inputs.command || \'\' }}\n      REPORT2_MANUAL_COIN_CONTRACT: ${{ inputs.coin_contract || \'\' }}\n      REPORT2_MANUAL_REQUEST_FILE: ${{ github.event_name == \'push\' && \'manual-requests/run.json\' || \'\' }}\n      REPORT2_CURRENT_POINTER_FILE: "REPORT2_CURRENT_GENERATION.json"\n      REPORT2_CURRENT_GENERATION: "MY_REPORT_2_CURRENT_20260929_CURRENT_CYCLE_V13_20M"\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: \'24\'\n      - name: Durably enqueue command before analytics concurrency\n        id: enqueue\n        run: node runner/enqueue-manual-command.mjs\n\n  run-report2:\n    needs: [execution-gate, enqueue-manual-command]\n    if: ${{ always() && needs.execution-gate.outputs.admitted == \'true\' && ((github.event_name == \'schedule\' && github.event.schedule == \'7,27,47 * * * *\') || inputs.scheduled_recovery_run == true || inputs.trigger_only_run == true || needs.enqueue-manual-command.result == \'success\' || inputs.reason == \'T00_RUNTIME_EXPORT\' || inputs.reason == \'T00_D1_INVENTORY\' || inputs.reason == \'V13_P0_READ_ONLY_DIAG\' || inputs.reason == \'V13_P0_DRY_RUN\' || inputs.reason == \'V13_SHADOW_MARKET_SMOKE\' || inputs.reason == \'V13_FINAL_37\' || inputs.reason == \'T16_DERIBIT_ALT_OPTIONS_SMOKE\' || inputs.reason == \'T16_CHAIN_SUPPLY_SMOKE\' || inputs.reason == \'T16_SOURCIFY_ABI_SMOKE\' || inputs.reason == \'T16_BLUESKY_ATTENTION_SMOKE\' || inputs.reason == \'T16_METADATA_SOURCES_SMOKE\' || inputs.reason == \'T16_OFFICIAL_FEED_SMOKE\' || inputs.reason == \'T16_LIDO_SNAPSHOT_SMOKE\' || inputs.reason == \'T16_LIGHTER_NATIVE_SMOKE\' || inputs.reason == \'T16_GMX_NATIVE_SMOKE\' || inputs.reason == \'T16_GTRADE_NATIVE_SMOKE\' || inputs.reason == \'T16_BLOCKSCOUT_INDEX_SMOKE\') }}\n    runs-on: ubuntu-24.04-arm\n    timeout-minutes: 25\n    concurrency:\n      group: my-report-2-production-cycle\n      cancel-in-progress: false\n    env:\n      REPORT2_RUNNER_ENABLED: ${{ secrets.REPORT2_RUNNER_ENABLED }}\n      ANALYTICS_ENABLED: "1"\n      PUBLIC_COLLECTOR_ENABLED: "0"\n      DELIVERY_ENABLED: ${{ (github.event_name == \'schedule\' || inputs.scheduled_recovery_run == true || inputs.trigger_only_run == true || (github.event_name == \'workflow_dispatch\' && inputs.isolated_telegram_validation == true) || (github.event_name == \'push\' && contains(github.event.head_commit.message, \'[telegram-canonical-delivery]\'))) && \'1\' || \'0\' }}\n      CALIBRATION_APPLY_ENABLED: "0"\n      REPORT2_MANUAL_RUN_AUTHORIZED: ${{ (github.event_name == \'push\' || (github.event_name == \'workflow_dispatch\' && inputs.manual_run_authorized == true)) && \'1\' || \'0\' }}\n      REPORT2_PAYLOAD_KEY: ${{ secrets.REPORT2_PAYLOAD_KEY }}\n      REPORT2_EXPECTED_WORKER_SHA: "e80352300ea533ce25d8eeb934e7057d51da1600d021c3dda5702721a16d3e17"\n      REPORT2_D1_BRIDGE_URL: ${{ secrets.REPORT2_D1_BRIDGE_URL }}\n      REPORT2_D1_BRIDGE_TOKEN: ${{ secrets.REPORT2_D1_BRIDGE_TOKEN }}\n      REPORT2_SOURCE_PROXY_URL: ${{ secrets.REPORT2_SOURCE_PROXY_URL }}\n      REPORT2_SOURCE_PROXY_TOKEN: ${{ secrets.REPORT2_SOURCE_PROXY_TOKEN }}\n      REPORT2_TELEGRAM_RELAY_URL: "https://my-report-2-hub.kovalev23091987.workers.dev/telegram-test"\n      REPORT2_TELEGRAM_RELAY_KEY: ${{ secrets.REPORT2_TELEGRAM_RELAY_KEY }}\n      REPORT2_TELEGRAM_REPORT_TEST: ${{ inputs.telegram_report_test || \'false\' }}\n      REPORT2_TELEGRAM_SHADOW_DECISION_AUTO: "0"\n      REPORT2_TELEGRAM_WATCH70_ENABLED: "1"\n      REPORT2_TELEGRAM_WATCH70_THRESHOLD: "70"\n      REPORT2_TELEGRAM_OUTPUT_ENABLED: ${{ github.event_name == \'workflow_dispatch\' && inputs.controlled_no_telegram == tru